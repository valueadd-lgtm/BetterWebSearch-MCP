# BetterWebSearch MCP - environment configuration
# Copy to .env and fill in the keys you have. All keys are optional;
# the server starts and falls back to keyless providers (DuckDuckGo) when absent.

# Brave Search API key (primary provider). Get one at https://brave.com/search/api/
BRAVE_API_KEY=

# Tavily Search API key (optional, used when present). https://tavily.com/
TAVILY_API_KEY=

# SerpApi key (optional, reserved for a future provider). https://serpapi.com/
SERPAPI_KEY=

# You.com API key (optional). When set, uses the keyed endpoint with higher
# limits. Without it, the keyless free-tier endpoint is used (100 searches/day).
# https://you.com/
YDC_API_KEY=
